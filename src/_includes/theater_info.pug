include theater_logo
include link_or_text
include social

mixin theater_info(theater)
  .theater_info
    +theater_logo(theater)
    .theater_content
      .theater_name
        +link_or_text(theater.link, theater.name)
        if theater.location.name
          = ' @ '
          +link_or_text(theater.location.link, theater.location.name)

      .theater_location
        +link_or_text(theater.location.link, theater.location.full)
      if theater.social
        .link_group
          +social_list(theater.social)
